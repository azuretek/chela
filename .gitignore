node_modules/
dist/
*.log
.DS_Store

# Generated at pack time by scripts/build-info.js. A commit cannot contain its
# own hash, so a checked-in copy would be wrong by construction; its absence is
# what makes a source run report itself as one. Under desktop/ since the repo
# became the product monorepo.
desktop/src/build-info.json

# Generated by xcodegen from mobile/project.yml, which is the single source of
# truth for the Xcode project's shape. Committing the output would make a second
# owner that drifts the first time a setting is changed in the Xcode UI, and the
# drift would not show up in review, because a pbxproj diff is unreadable either
# way. Rebuild it with `cd mobile && xcodegen generate`.
mobile/*.xcodeproj/
xcuserdata/

# The Apple team id that signs device builds. It is personal to the signing
# account, so it stays local and reaches the build as an env var or as
# mobile/.team; mobile/build-device.sh is the only reader. Keeping it out of
# project.yml means there is no committed copy to drift from the account.
mobile/.team

# The gateway address a local build points at. Personal to whoever's machine it
# is, so it stays out of the repo exactly as the team id does. Config/
# Local.xcconfig carries the placeholder default and includes this file when it
# exists; the app reads the value out of its own Info.plist at runtime.
mobile/Config/Local.private.xcconfig

# Device build output from mobile/build-device.sh. Regenerated on every run, so
# a committed copy would be pure drift, and it is large.
mobile/build-device/
