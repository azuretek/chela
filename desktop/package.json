{
  "name": "claw-desktop",
  "productName": "Claw Control UI",
  "version": "1.0.0",
  "description": "Claw Control UI - a desktop shell for the OpenClaw Control UI",
  "type": "module",
  "main": "src/main.js",
  "desktopName": "claw-desktop.desktop",
  "author": "Abi Renhart",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "node --test test/*.test.js",
    "measure": "electron scripts/capture-pages.js && electron scripts/capture-gateway-form.js && electron scripts/measure-text-scale.mjs && electron scripts/prove-banner-width.mjs && electron scripts/prove-frame-inset.mjs",
    "lint": "eslint .",
    "check:imports": "node scripts/check-imports.js",
    "check:package": "node scripts/check-package.js",
    "test:update-stall": "electron scripts/test-update-stall.js",
    "test:update-relaunch": "node scripts/test-update-relaunch.js",
    "smoke": "node scripts/smoke.js --instance source",
    "smoke:packed": "node scripts/smoke.js --instance packed",
    "verify": "npm test && npm run check:imports && npm run smoke",
    "prestart": "node scripts/build-info.js --clear",
    "start": "electron .",
    "icons": "node scripts/make-icons.mjs",
    "pack": "node scripts/build.js --dir",
    "build:mac": "node scripts/build.js --mac",
    "build:win": "node scripts/build.js --win",
    "build:linux": "node scripts/build.js --linux",
    "release": "release-it",
    "build:version": "node scripts/build-version.js",
    "hooks:install": "git config core.hooksPath \"$(git rev-parse --show-toplevel)/.githooks\" && echo \"hooks installed: core.hooksPath -> .githooks\""
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "release-it": "^21.0.2",
    "sharp": "^0.35.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azuretek/claw-control-ui.git"
  },
  "homepage": "https://github.com/azuretek/claw-control-ui",
  "bugs": {
    "url": "https://github.com/azuretek/claw-control-ui/issues"
  },
  "dependencies": {
    "claw-core": "workspace:*",
    "electron-updater": "^6.8.9"
  }
}
