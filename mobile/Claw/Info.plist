<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The home-screen label and the name in TestFlight. Kept short: a longer
	     one is truncated under the icon, which is the wrong place to learn it. -->
	<key>CFBundleDisplayName</key>
	<string>Claw</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- No NSAppTransportSecurity key, and that is a decision rather than an
	     oversight. The gateway this app loads is a Tailscale Serve address whose
	     certificate is a real one, so nothing needs an exception, and
	     NSAllowsArbitraryLoads would weaken every other load in the app to solve
	     a problem this phase does not have. The gateway's own :18789 listener is
	     self-signed and is Phase 4's problem; pinning a fingerprint is the fix
	     for it, not turning ATS off. -->

	<!-- SwiftUI's App lifecycle brings its own scene; this only declares that
	     the app is single-window, which is what a phone client is. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- An empty launch screen is a real one. Without the key at all, iOS
	     assumes the app cannot size itself to the display and letterboxes it at
	     an old device size. -->
	<key>UILaunchScreen</key>
	<dict/>

	<!-- Up is a phone orientation and upside-down is not, the same default
	     Apple's own iOS template ships. The web view is laid out by the page, so
	     it rotates with the device without any native work. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- An iPad key: it opts the app out of multitasking. The app is iPhone only
	     (TARGETED_DEVICE_FAMILY = 1), so this is inert today and here to keep
	     that intent explicit if a tablet build is ever considered. -->
	<key>UIRequiresFullScreen</key>
	<true/>

	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleDefault</string>
</dict>
</plist>
