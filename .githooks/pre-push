#!/bin/sh
# pre-push: the QUICK half of the local gate.
#
# Abi, 2026-10-04: "all heavy checks must live on CI, pre-commit is for quick
# static analysis and linting and other types of rules like that."
#
# This hook used to run `npm run verify`: the desktop unit suite, the import audit
# AND the Electron boot smoke, plus the packaged-artifact audit when a build was
# present. The smoke is the heavy one, it launches the real app. CI runs all of it on
# every pull request in the desktop job (.github/workflows/ci.yml: the boot smoke,
# `npm run measure`, the packaged audit, the packed smoke) with the merge gate on
# them, so the heavy checks MOVED; they were not dropped.
#
# The desktop suite and the import audit are what remains: seconds, no Electron.
#
# ★ THE DESKTOP SUITE ONLY, not `npm run test:js`. Its sibling, `cd core && npm test`,
# is deliberately not a CI gate and cannot pass on every machine: half of it holds our
# markup and our copy of the card against a LIVE OpenClaw checkout, and it asserts that
# the checkout is the revision the pin names. On a machine whose checkout is another
# release, that suite is red for a reason that has nothing to do with the commit being
# pushed (measured 2026-10-04: the checkout here is 2026.8.1 and the pin names 2026.9.5,
# so sixteen card values read as drift). A push gate must not be red for that. Run it on
# purpose, on a machine carrying the pinned checkout: cd core && npm test.
#
# It is ADVISORY, and not the gate: `git push --no-verify` skips it, and a fresh clone
# has no hook until `npm run hooks:install` points core.hooksPath here. The unskippable
# gate is the CI run on the commit you pushed.

set -e

root="$(git rev-parse --show-toplevel)"
cd "$root"

fail() {
  cat >&2 <<EOF

pre-push: ${1}

The quick local gate, from the repo root:
  pnpm --filter chela-desktop run test   the desktop unit suite
  npm run check:imports                  the static import audit

Everything heavy is CI's, on the pull request:
  npm run smoke, npm run measure, npm run check:package, npm run smoke:packed
  (the desktop job in .github/workflows/ci.yml, with the merge gate on it)

The live half of core's suite is deliberately not here: it needs the pinned OpenClaw
checkout. Run it on purpose, on a machine that has one: cd core && npm test

Fix the failure and push again, or deliberately skip the local copy with:

    git push --no-verify
EOF
  exit 1
}

# A checkout with no install cannot run the suite, and a silent pass is a green line
# for work nobody did. The reason is named instead, the way the rest of this repo's
# harnesses treat a host that cannot run them.
if [ ! -d desktop/node_modules ]; then
  cat >&2 <<'EOF'

pre-push: SKIPPED the quick gate, and the reason is named.

  There is no desktop/node_modules in this checkout, so the desktop suite and the
  import audit cannot run here. Install at the repo root (pnpm install), or push from
  a checkout that has one.

  This is a SKIP, not a pass: nothing was checked. CI runs both on the pull request.
EOF
  exit 0
fi

echo "pre-push: the quick gate (desktop unit suite, import audit)"
if ! pnpm --filter chela-desktop run test; then
  fail "the desktop unit suite failed."
fi
if ! npm run check:imports; then
  fail "the import audit failed."
fi

echo "pre-push: the quick gate passed; the smoke, the measurements and the packaged audits run in CI."
