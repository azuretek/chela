#!/bin/sh
# pre-push: the local copy of the desktop gate.
#
# Where this lives now. The hook is at the REPO ROOT (core.hooksPath -> .githooks)
# and it runs ROOT scripts. It used to cd into desktop/ and call that package's
# npm scripts directly, which was one more way desktop acted as the root. The GUI
# boot smoke is still the desktop's work (it launches Electron), but the hook
# reaches it through the root now, the same way the root reaches every platform.
#
# The split, and why it is a split at all.
#
# CI runs all of this on every pull request: the unit tests, the import audit,
# the iOS legs, and in the desktop job (.github/workflows/ci.yml) the GUI boot
# smoke, the packaged-artifact audit and the packed smoke, in Electron under a
# virtual display on Linux. The smoke is the check that catches the fault which
# actually shipped: a build that passed every test and still opened a fatal
# "A JavaScript error occurred in the main process" dialog. A green unit-test run
# is not evidence the app starts.
#
# This hook runs the same checks before the push, so a fault is seen here rather
# than minutes later on the pull request.
#
# This hook is ADVISORY, and do not mistake it for the gate. `git push --no-verify`
# skips it, and a fresh clone has no hook until `npm run hooks:install` points
# core.hooksPath here. The unskippable gate is the CI run on the commit you pushed.
# Treat a green hook as the fast local signal, never as the only one.

set -e

root="$(git rev-parse --show-toplevel)"
cd "$root"

fail() {
  cat >&2 <<EOF

pre-push: ${1}

The local gate, from the repo root:
  npm test            every platform's tests through the root fan-out
  npm run check:imports   static import audit over the desktop source
  npm run smoke       boot the real Electron app and require a positive signal
  npm run check:package   audit the packaged artifact, when one exists

CI runs the same checks on the pull request, and the merge gate needs them, so a
skip here only moves the failure there. Fix the failure and push again, or
deliberately skip the local copy with:

    git push --no-verify
EOF
  exit 1
}

# Scope to the change. The local gate is the JS app's: the desktop unit suite,
# the import audit and an Electron boot smoke. A push whose commits touch nothing
# under desktop/, core/ or a root manifest cannot change the app, so the smoke
# would be a multi-minute Electron launch for no signal (Abi, 2026-09-18). CI
# still runs every check on the pull request, the smoke and the iOS legs included.
changed="$(
  while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
      base="$(git merge-base "$local_sha" refs/remotes/origin/HEAD 2>/dev/null || true)"
      if [ -n "$base" ]; then git diff --name-only "$base..$local_sha" || true; fi
    else
      git diff --name-only "$remote_sha..$local_sha" || true
    fi
  done
)"
if [ "$(printf '%s\n' "$changed" | node scripts/hook-scope.mjs)" = "skip" ]; then
  echo "pre-push: SKIPPED the local gate; nothing pushed touches desktop/, core/ or a root manifest."
  echo "          CI runs the headless gate on this commit, so this is a skip, not a pass."
  exit 0
fi

echo "pre-push: local gate (desktop unit tests, import audit, GUI boot smoke)"
if ! npm run verify; then
  fail "the verification suite failed."
fi

# A packaged build, if one is sitting there, is worth auditing on the way out:
# this is the check that catches a module the packer never copied, which is a
# fault the source tree cannot show. CI packs and audits on every pull request
# (the desktop job), so this is the local equivalent of that step.
if [ -d desktop/dist ]; then
  echo "pre-push: auditing the packaged build in desktop/dist/"
  if ! npm run check:package; then
    fail "the packaged-artifact audit failed."
  fi
fi

echo "pre-push: local gate passed."
