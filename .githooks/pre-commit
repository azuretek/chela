#!/bin/sh
# pre-commit: the measured half, at the commit.
#
# Where this lives now. The hook is at the REPO ROOT (core.hooksPath -> .githooks)
# and it runs a ROOT script, not a script inside desktop/. It used to cd into
# desktop/ and call that package's npm scripts directly, which was one more way
# the desktop package acted as the root. The page measurement is still the
# desktop's work (it renders core/ui in Electron), but it is reached through the
# root, the same way the root scripts reach every platform. No platform is the
# root.
#
# The split, and why this is a second hook rather than more of pre-push.
#
# CI runs these too. The desktop job in .github/workflows/ci.yml runs
# `npm run measure`, the boot smoke and every proof harness in Electron under a
# virtual display on Linux, on every pull request, and the merge gate needs it.
# This hook is the fast local copy of the same measurement, so a fault is seen at
# the commit rather than at the pull request.
#
# A page measurement is the only witness for a claim about what was DRAWN. No
# unit test and no assertion over source can tell a rule that applies from one that
# is overridden, a strip that paints from one the page shows through, or a control
# that is present from one that is dead. `npm run measure` loads the real pages
# from core/ui with a stub host and measures the rendered result.
#
# It is PER HOST rather than per platform: whoever has a checkout and a session
# runs it, because the harnesses are Electron and Electron is the same program
# everywhere. A host with no Electron SKIPS with a named reason rather than
# passing quietly: a silent pass is a green line for work nobody did.
#
# It is ADVISORY, like the push gate: `git commit --no-verify` skips it, and a
# fresh clone has no hook until `npm run hooks:install` points core.hooksPath here.

set -e

root="$(git rev-parse --show-toplevel)"
cd "$root"

# Scope to the change, before anything heavy is even looked for. The measured
# half renders core/ui in Electron, so it only means anything when the pages or
# the code that builds them moved. A commit that touches only mobile/, docs/,
# .github/ or other paths cannot change a rendered page, and paying a
# multi-minute Electron launch for it is what made every commit slow (Abi,
# 2026-09-18). CI measures every pull request that touches the pages whatever
# this hook skips, so scoping here is a local decision, not a hole.
decision="$(git diff --cached --name-only | node scripts/hook-scope.mjs)"
if [ "$decision" = "skip" ]; then
  cat >&2 <<'EOF'

pre-commit: SKIPPED the page measurements, and the reason is named.

  Nothing staged touches desktop/, core/, a root manifest or a root script, so no
  rendered page or form can have changed: an Electron render would measure the
  same pixels as last time.

  This is a SKIP, not a pass: the pages were not measured, because nothing in
  this commit can have moved them.
EOF
  exit 0
fi

# The package DIRECTORY rather than a binary name, so this reads the same on every
# platform: a Windows checkout has node_modules/electron and electron.cmd rather
# than a file called `electron`. A present-but-broken install is not skipped:
# `npm run measure` then fails with Electron's own error, which is the honest
# answer for an install that cannot start.
if [ ! -d "desktop/node_modules/electron" ]; then
  cat >&2 <<'EOF'

pre-commit: SKIPPED, and the reason is named rather than assumed.

  There is no Electron in desktop/node_modules, so no page can be rendered here
  and the measured half cannot run. Install it with a workspace install at the
  repo root (`pnpm install`), or run the harnesses on a host that has it.

  This is a SKIP, not a pass: the pages were not measured.
EOF
  exit 0
fi

echo "pre-commit: the measured half (the pages and the forms, as rendered)"
if ! npm run measure; then
  cat >&2 <<'EOF'

pre-commit: the measured harnesses failed.

  These load the real pages from core/ui in Electron and measure what was DRAWN:
  the strip's own pixels, the card's surface, and the two gateway forms' fields
  lining up, in both appearances. Read the failing line above, and look at the
  screenshots the harness just wrote.

  A deliberate skip is `git commit --no-verify`. It should be rare: this is the
  only check that sees the rendered page.
EOF
  exit 1
fi

echo "pre-commit: the measured half passed."
