#!/bin/sh
# pre-commit: the QUICK half only, and that is the rule now.
#
# Abi, 2026-10-04: "all heavy checks must live on CI, pre-commit is for quick
# static analysis and linting and other types of rules like that."
#
# So the measured half is gone from here. This hook used to end with
# `npm run measure`, the Electron page renderers, scoped by scripts/hook-scope.mjs
# so it ran only when the pages could have moved. Scoped or not, it was a
# multi-minute Electron launch inside every commit that touched desktop/ or core/,
# which made committing the slow thing it should never be. CI runs the same
# measurement on every pull request that can move a rendered page (the desktop job
# in .github/workflows/ci.yml: `npm run measure`, the boot smoke, every proof
# harness, the packaged audits), and the merge gate needs it. The measurement
# MOVED to CI, it was not dropped.
#
# What remains is what a commit can answer for itself in seconds: linting of the
# staged JS and Swift. A check that needs Electron, a browser, a package build or a
# network belongs in CI, however fast it feels on a quiet machine.
#
# The hook is at the REPO ROOT (core.hooksPath -> .githooks) and it runs ROOT
# scripts, not a package's. No platform is the root.
#
# It is ADVISORY: `git commit --no-verify` skips it, and a fresh clone has no hook
# until `npm run hooks:install` points core.hooksPath here.

set -e

root="$(git rev-parse --show-toplevel)"
cd "$root"

# The lint half, first and always: it is seconds, not an Electron launch.
# It lints only what this commit stages: the JS under core/ and desktop/ with the
# root ESLint config, and the Swift under mobile/ with SwiftLint, the same two
# linters `pnpm run lint` runs over the whole tree. A host without SwiftLint gets
# mobile.mjs's own named skip.
staged_js="$(git diff --cached --name-only --diff-filter=ACMR -- 'core/*.js' 'core/*.mjs' 'core/*.ts' 'desktop/*.js' 'desktop/*.mjs' 'desktop/*.ts')"
if [ -n "$staged_js" ] && [ ! -x node_modules/.bin/eslint ]; then
  echo "pre-commit: lint SKIPPED, and the reason is named: no ESLint in node_modules (run pnpm install at the repo root). The staged JS was NOT linted." >&2
elif [ -n "$staged_js" ]; then
  echo "pre-commit: lint (ESLint on the staged JS)"
  if ! printf '%s\n' "$staged_js" | tr '\n' '\0' | xargs -0 pnpm exec eslint --no-warn-ignored; then
    echo "pre-commit: ESLint refused the commit; fix the findings above." >&2
    exit 1
  fi
fi
if git diff --cached --name-only --diff-filter=ACMR -- 'mobile/*.swift' | grep -q .; then
  echo "pre-commit: lint (SwiftLint, because Swift is staged)"
  if ! node scripts/mobile.mjs lint; then
    echo "pre-commit: SwiftLint refused the commit; fix the findings above." >&2
    exit 1
  fi
fi

echo "pre-commit: the quick half passed; the measurements and the smoke run in CI on the pull request."
